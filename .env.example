# Copy to .env for local development. Never commit real values.
# Production values are set in Railway (see docs/SETUP.md), not in files.

APP_ENV=development
LOG_LEVEL=info

# Postgres connection used by the API and worker. On Supabase use the *Session pooler* connection string
# (port 5432), not the transaction pooler: the job queue needs LISTEN/NOTIFY.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/dentalos

# Only for running tests locally: a server where tests may create throwaway databases.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/postgres

# Staff sign-in. Production/staging: AUTH_JWKS_URL from Supabase. Local: a secret plus DEV_LOGIN=on.
AUTH_JWKS_URL=
AUTH_JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
DEV_LOGIN=on
WEB_ORIGINS=http://localhost:3000

# Dashboard (apps/web) settings, read at request time.
API_URL=http://localhost:8080
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional error tracking (PII is scrubbed before sending).
SENTRY_DSN=

# Provider selection. "fake" everywhere until each real adapter is built; production refuses "fake".
MESSAGING_PROVIDER=fake
TELEPHONY_PROVIDER=fake
VOICE_PROVIDER=fake
LLM_PROVIDER=fake
PAYMENT_PROVIDER=fake
SMS_PROVIDER=fake
STORAGE_PROVIDER=fake
