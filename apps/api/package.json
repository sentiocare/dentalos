{
  "name": "@dentalos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ../../scripts/build-node.mjs src/server.ts && node ../../scripts/build-node.mjs src/admin/cli.ts dist/admin.js",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed:demo": "tsx src/admin/seed-demo.ts",
    "clinic:create": "tsx src/admin/create-clinic.ts"
  },
  "dependencies": {
    "@dentalos/adapters": "workspace:*",
    "@dentalos/core": "workspace:*",
    "@dentalos/db": "workspace:*",
    "@dentalos/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@sentry/node": "^11.0.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
